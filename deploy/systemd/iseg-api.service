# Interactive labelling web app (uvicorn), on localhost only; Apache publishes
# it at https://<server>/iseg/ (deploy/apache/iseg.conf). Clicks and
# Auto-label run here on the CPU; every model training runs as a child worker
# process of this service on one GPU (ISEG_TRAIN_DEVICE).
#
# A template: the @...@ values are filled in for the server by
# deploy/tensor2.md, step 5, which installs the result as
# /etc/systemd/system/iseg-api.service.
[Unit]
Description=Interactive labelling (uvicorn on 127.0.0.1:@ISEG_PORT@, behind Apache at /iseg/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ISEG_USER@
Group=@ISEG_GROUP@
WorkingDirectory=@ISEG_APP@
Environment=PYTHONUNBUFFERED=1
# Clicks and the training worker use the CPU too; keep them from taking every
# core from the server's other work.
Environment=OMP_NUM_THREADS=8
Environment=MKL_NUM_THREADS=8
# Trainings run one at a time, as local worker processes, on this GPU.
# Pick one that the other apps on the server leave free (nvidia-smi).
Environment=ISEG_TRAIN_DEVICE=@ISEG_GPU@
# One process only: sessions, loaded models and the training queue live in memory.
ExecStart=@ISEG_APP@/.venv/bin/python -m server.main --cpu --host 127.0.0.1 --port @ISEG_PORT@
Restart=always
RestartSec=5
# Stopping kills the service's whole cgroup, the training worker included, so a
# training in progress is cancelled with it (it shows as interrupted after the restart).
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
