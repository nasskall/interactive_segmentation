# Interactive labelling web app (uvicorn), on localhost only, for a server
# without Slurm; Apache publishes it at https://<server>/iseg/
# (deploy/apache/iseg.conf). Clicks and Auto-label run here on the CPU; every
# model training runs as a child worker process of this service on one GPU
# (ISEG_TRAIN_DEVICE). The user, folder, GPU and port below are placeholders
# from ailab26: deploy/tensor2.md (step 5) makes the server's own copy as
# /etc/systemd/system/iseg-api.service. With Slurm, use iseg-api.service.
[Unit]
Description=Interactive labelling (uvicorn on 127.0.0.1:8020, behind Apache at /iseg/)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin_ai
Group=admin_ai
WorkingDirectory=/home/admin_ai/ai_apps/interactive_segmentation
Environment=PYTHONUNBUFFERED=1
# Clicks and the training worker use the CPU too; keep them from taking all
# 48 cores from the server's other work.
Environment=OMP_NUM_THREADS=8
Environment=MKL_NUM_THREADS=8
# Trainings run one at a time, as local worker processes, on this GPU.
# Pick one that the other apps on the server leave free (nvidia-smi).
Environment=ISEG_TRAIN_DEVICE=cuda:0
# One process only: sessions, loaded models and the training queue live in memory.
ExecStart=/home/admin_ai/ai_apps/interactive_segmentation/.venv/bin/python -m server.main --cpu --host 127.0.0.1 --port 8020
Restart=always
RestartSec=5
# Stopping kills the service's whole cgroup, the training worker included, so a
# training in progress is cancelled with it (it shows as interrupted after the restart).
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
